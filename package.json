{
  "name": "pokemon-fullstack",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n \"API,APP\" -c \"bgBlue.bold,bgGreen.bold\" \"npm --prefix server run dev\" \"vite\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "build:full": "npm run build && npm --prefix server run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "helmet": "^7.2.0",
    "morgan": "^1.12.1",
    "node-cache": "^5.1.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "@types/react": "^17.0.33",
    "@types/react-dom": "^17.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^1.0.7",
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3",
    "vite": "^2.9.0"
  }
}
